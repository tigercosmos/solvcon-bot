# Copy to scripts/e2e.env and fill in. Loaded by scripts/e2e_ping.sh.
# scripts/e2e.env is gitignored.

# Target repo. Forked or sandboxed copy of modmesh recommended so the
# bot's test comments don't pollute the main project.
GITHUB_REPO=tigercosmos/modmesh

# Bot identity. The bot GitHub account must be a collaborator on
# $GITHUB_REPO (or, for org repos, a member of a team with write
# access).
BOT_HANDLE=modmesh-bot-test
# PAT for the bot account. Classic: repo + read:org. Fine-grained:
# pull-requests:write, contents:read, metadata:read, members:read.
BOT_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Mentioner identity. Must be a collaborator (so the ping path passes
# the is_collaborator check). This can be your own personal account.
USER_LOGIN=tigercosmos
# PAT for the mentioner. Needs repo + read:org (or fine-grained issues:write).
USER_TOKEN=ghp_yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy

# PR number to leave the test mention on. The PR must be open in
# $GITHUB_REPO. Either reuse an existing one or open a throwaway PR.
TEST_PR_NUMBER=1

# Reviewer CLI. /bin/cat keeps the e2e free and deterministic.
# Set to ["claude","-p"] or ["codex","exec"] for a real AI review.
REVIEWER_ARGV=["/bin/cat"]

# Optional: where to put the bot's state file during the test. We
# clean this up between runs so the bot doesn't think the comment is
# already handled.
STATE_FILE=/tmp/modmesh-bot-e2e.state
